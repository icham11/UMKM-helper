// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum PaymentMethod {
  Digital
  QRIS
  Transfer
  Cash
}

enum PaymentStatus {
  Pending
  Paid
}

enum StockDocumentType {
  Purchase
  Sale
  Waste
}

enum InventoryMovementType {
  In
  Out
}

// ==================== CORE LAYER ====================

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  businesses Business[]
}

model Business {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories           Category[]
  products             Product[]
  ingredients          Ingredient[]
  sales                Sale[]
  stockDocuments       StockDocument[]
  businessMetrics      BusinessMetrics[]
  businessHealthScores BusinessHealthScores[]
}

// ==================== PRODUCT LAYER ====================

model Category {
  id         Int      @id @default(autoincrement())
  businessId Int
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]
}

model Product {
  id           Int      @id @default(autoincrement())
  businessId   Int
  categoryId   Int?
  name         String
  sellingPrice Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipes        Recipe[]
  saleItems      SaleItem[]
  productMetrics ProductMetrics[]
  productForecasts ProductForecast[]
}

// ==================== INVENTORY LAYER ====================

model Ingredient {
  id        Int      @id @default(autoincrement())
  businessId Int
  name      String
  unit      String
  minStock  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipes            Recipe[]
  inventoryMovements InventoryMovement[]
  inventoryBatches   InventoryBatch[]
}

model Recipe {
  id           Int      @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Decimal  @db.Decimal(10, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
}

model StockDocument {
  id         Int               @id @default(autoincrement())
  businessId Int
  type       StockDocumentType
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  sales              Sale[]
}

model InventoryMovement {
  id              Int                   @id @default(autoincrement())
  ingredientId    Int
  stockDocumentId Int
  quantity        Decimal               @db.Decimal(10, 3)
  costPerUnit     Decimal               @db.Decimal(12, 2)
  type            InventoryMovementType
  createdAt       DateTime              @default(now())

  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  stockDocument StockDocument @relation(fields: [stockDocumentId], references: [id], onDelete: Cascade)
}

model InventoryBatch {
  id             Int       @id @default(autoincrement())
  ingredientId   Int
  remainingQty   Decimal   @db.Decimal(10, 3)
  costPerUnit    Decimal   @db.Decimal(12, 2)
  receivedAt     DateTime  @default(now())
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

// ==================== SALES LAYER ====================

model Sale {
  id                Int           @id @default(autoincrement())
  businessId        Int
  stockDocumentId   Int?
  transactionNumber String        @unique
  totalRevenue      Decimal       @db.Decimal(12, 2)
  totalCost         Decimal       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(Pending)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockDocument StockDocument? @relation(fields: [stockDocumentId], references: [id], onDelete: SetNull)
  saleItems     SaleItem[]
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int
  productId   Int
  quantity    Int
  priceAtSale Decimal  @db.Decimal(12, 2)
  costAtSale  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ==================== ANALYTICS LAYER ====================

model BusinessMetrics {
  id           Int      @id @default(autoincrement())
  businessId   Int
  date         DateTime @db.Date
  totalRevenue Decimal  @db.Decimal(14, 2)
  totalCost    Decimal  @db.Decimal(14, 2)
  totalProfit  Decimal  @db.Decimal(14, 2)
  marginAvg    Float
  growthRate   Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

model ProductMetrics {
  id           Int      @id @default(autoincrement())
  productId    Int
  date         DateTime @db.Date
  quantitySold Int
  revenue      Decimal  @db.Decimal(14, 2)
  cost         Decimal  @db.Decimal(14, 2)
  profit       Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
}

model ProductForecast {
  id                    Int      @id @default(autoincrement())
  productId             Int
  date                  DateTime @db.Date
  predictedQty          Int
  recommendedProduction String?
  confidenceScore       Decimal  @db.Decimal(5, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
}

model BusinessHealthScores {
  id             Int      @id @default(autoincrement())
  businessId     Int
  date           DateTime @db.Date
  revenueScore   Float
  profitScore    Float
  wasteScore     Float
  stabilityScore Float
  overallScore   Float
  classification String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}
