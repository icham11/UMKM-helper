// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
  
}

// ==================== ENUMS ====================

enum PaymentMethod {
  Digital
  QRIS
  Transfer
  Cash
}

enum PaymentStatus {
  Pending
  Paid
}

enum StockDocumentType {
  Purchase
  Sale
  Waste
}

enum InventoryMovementType {
  In
  Out
}

// ==================== CORE LAYER ====================

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  businesses Business[]
}

model Business {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories           Category[]
  products             Product[]
  ingredients          Ingredient[]
  sales                Sale[]
  stockDocuments       StockDocument[]
  businessMetrics      BusinessMetrics[]
  businessHealthScores BusinessHealthScores[]
  chatMessages         ChatMessage[]
  chatSessions         ChatSession[]
  documents            BusinessDocument[]

  // requireAuth: findFirst where userId, orderBy createdAt
  // GET /api/businesses: findMany where userId
  @@index([userId, createdAt])
}

// ==================== RAG VECTOR LAYER ====================

model BusinessDocument {
  id         Int                          @id @default(autoincrement())
  businessId Int
  content    String                       @db.Text
  embedding  Unsupported("vector(768)")?
  sourceType String                       // "product" | "ingredient" | "sale" | "recipe" | "metric" | "health"
  sourceId   Int?
  metadata   Json?
  chunkIndex Int                          @default(0)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // RAG: findMany where businessId + sourceType; deleteMany where businessId
  @@index([businessId, sourceType])
  @@index([businessId])
  @@index([sourceType])
}

// ==================== AI CHAT LAYER ====================

model ChatSession {
  id         Int      @id @default(autoincrement())
  businessId Int
  title      String   @default("New Chat")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  // getChatSessions: findMany where businessId, orderBy updatedAt DESC
  @@index([businessId, updatedAt(sort: Desc)])
}

model ChatMessage {
  id            Int      @id @default(autoincrement())
  businessId    Int
  sessionId     Int?
  role          String   // "user" | "assistant" | "system"
  content       String
  contextType   String?  // "sales" | "inventory" | "product" | "general"
  metadata      Json?    // extra context data
  createdAt     DateTime @default(now())

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  session  ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // getChatHistory: where businessId+sessionId, orderBy createdAt
  @@index([businessId, sessionId, createdAt])
  @@index([sessionId, createdAt])
}

// ==================== PRODUCT LAYER ====================

model Category {
  id         Int      @id @default(autoincrement())
  businessId Int
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  // GET /api/categories: findMany where businessId
  // resolveCategory: case-insensitive lookup within business
  @@index([businessId])
}

model Product {
  id           Int      @id @default(autoincrement())
  businessId   Int
  categoryId   Int?
  name         String
  sellingPrice Decimal  @db.Decimal(12, 2)
  recipeCost   Decimal  @default(0) @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipes        Recipe[]
  saleItems      SaleItem[]
  productMetrics ProductMetrics[]
  productForecasts ProductForecast[]

  // GET /api/products: findMany where businessId + deletedAt: null
  // AI chat: findMany where businessId + isActive
  @@index([businessId, isActive])
  @@index([businessId, deletedAt])
  @@index([businessId, categoryId])
  @@index([categoryId])
}

// ==================== INVENTORY LAYER ====================

model Ingredient {
  id        Int      @id @default(autoincrement())
  businessId Int
  name      String
  unit      String
  minStock  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipes            Recipe[]
  inventoryMovements InventoryMovement[]
  inventoryBatches   InventoryBatch[]

  // GET /api/ingredients: findMany where businessId, orderBy createdAt
  // AI: findMany where businessId (inventory alerts)
  @@index([businessId, createdAt(sort: Desc)])
}

model Recipe {
  id           Int      @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Decimal  @db.Decimal(10, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  // calculateProductCost, deductInventory: findMany where productId
  @@index([productId])
  @@index([ingredientId])
}

model StockDocument {
  id         Int               @id @default(autoincrement())
  businessId Int
  type       StockDocumentType
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  sales              Sale[]

  // Created during sales and restocks, queried by businessId
  @@index([businessId, type])
}

model InventoryMovement {
  id              Int                   @id @default(autoincrement())
  ingredientId    Int?
  stockDocumentId Int
  quantity        Decimal               @db.Decimal(10, 3)
  costPerUnit     Decimal               @db.Decimal(12, 2)
  type            InventoryMovementType
  /// Preserved when the ingredient is later deleted
  ingredientNameSnapshot String?
  ingredientUnitSnapshot String?
  createdAt       DateTime              @default(now())

  ingredient    Ingredient?   @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  stockDocument StockDocument @relation(fields: [stockDocumentId], references: [id], onDelete: Cascade)

  // deductInventory: create with ingredientId + stockDocumentId
  // waste analytics: aggregate by ingredientId + type
  @@index([ingredientId, type])
  @@index([stockDocumentId])
  @@index([ingredientId, createdAt])
}

model InventoryBatch {
  id             Int       @id @default(autoincrement())
  ingredientId   Int
  remainingQty   Decimal   @db.Decimal(10, 3)
  costPerUnit    Decimal   @db.Decimal(12, 2)
  receivedAt     DateTime  @default(now())
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  // FIFO engine: findMany where ingredientId + remainingQty > 0, orderBy receivedAt ASC
  // This is the most performance-critical query (runs inside sale transactions)
  @@index([ingredientId, receivedAt])
  @@index([ingredientId, remainingQty])
}

// ==================== SALES LAYER ====================

model Sale {
  id                Int           @id @default(autoincrement())
  businessId        Int
  stockDocumentId   Int?
  transactionNumber String        @unique
  totalRevenue      Decimal       @db.Decimal(12, 2)
  totalCost         Decimal       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(Pending)
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  invoiceId         String?
  invoiceUrl        String?
  invoiceStatus     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockDocument StockDocument? @relation(fields: [stockDocumentId], references: [id], onDelete: SetNull)
  saleItems     SaleItem[]

  // GET /api/sales: findMany where businessId, orderBy createdAt DESC (+ date range)
  @@index([businessId, createdAt(sort: Desc)])
  // Profile/Business stats: count/aggregate where businessId + paymentStatus
  @@index([businessId, paymentStatus])
  // Midtrans webhook: findUnique where transactionNumber (already @unique, but compound helps)
  // Sales history filter: businessId + paymentMethod
  @@index([businessId, paymentMethod])
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int
  productId   Int
  quantity    Int
  priceAtSale Decimal  @db.Decimal(12, 2)
  costAtSale  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Include in sale queries: where saleId (join)
  @@index([saleId])
  // AI forecast, product analytics: where sale.businessId via productId
  @@index([productId])
}

// ==================== ANALYTICS LAYER ====================

model BusinessMetrics {
  id           Int      @id @default(autoincrement())
  businessId   Int
  date         DateTime @db.Date
  totalRevenue Decimal  @db.Decimal(14, 2)
  totalCost    Decimal  @db.Decimal(14, 2)
  totalProfit  Decimal  @db.Decimal(14, 2)
  marginAvg    Float
  growthRate   Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  // Analytics insight: findMany where businessId + date range, orderBy date DESC
  @@index([businessId, date(sort: Desc)])
}

model ProductMetrics {
  id           Int      @id @default(autoincrement())
  productId    Int
  date         DateTime @db.Date
  quantitySold Int
  revenue      Decimal  @db.Decimal(14, 2)
  cost         Decimal  @db.Decimal(14, 2)
  profit       Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  // Top products analytics: aggregate by productId + date range
  @@index([productId, date(sort: Desc)])
}

model ProductForecast {
  id                    Int      @id @default(autoincrement())
  productId             Int
  date                  DateTime @db.Date
  predictedQty          Int
  recommendedProduction String?
  confidenceScore       Decimal  @db.Decimal(5, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
}

model BusinessHealthScores {
  id             Int      @id @default(autoincrement())
  businessId     Int
  date           DateTime @db.Date
  revenueScore   Float
  profitScore    Float
  wasteScore     Float
  stabilityScore Float
  overallScore   Float
  classification String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  // Health score trend: orderBy date DESC
  @@index([businessId, date(sort: Desc)])
}

// ==================== WEBHOOK IDEMPOTENCY ====================

model WebhookEvent {
  id              Int      @id @default(autoincrement())
  eventId         String   @unique            // Unique key: e.g. "midtrans:{order_id}:{status}"
  source          String                       // "midtrans" | "xendit" | etc.
  status          String   @default("processing") // "processing" | "completed" | "failed"
  payload         Json?                        // Raw webhook payload for debugging
  processedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([source])
  @@index([createdAt])
  // cleanupOldWebhookEvents: deleteMany where status IN (...) + createdAt < cutoff
  @@index([status, createdAt])
}
